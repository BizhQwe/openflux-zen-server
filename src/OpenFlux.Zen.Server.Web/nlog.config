<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/nlog-internal.log">

  <targets>
    <!-- Console Target with colors -->
    <target xsi:type="ColoredConsole" name="console"
            layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff} [${level:uppercase=true:padding=-5}] [${logger}] ${message} ${exception:format=tostring}" />

    <!-- File Target with rolling daily logs -->
    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/panel-${shortdate}.log"
            layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff} [${level:uppercase=true:padding=-5}] [${logger}] ${message} ${exception:format=tostring}"
            archiveFileName="${basedir}/logs/archives/panel-{#}.log"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveFiles="14"
            keepFileOpen="false"
            encoding="utf-8" />
  </targets>

  <rules>
    <!-- Suppress verbose ASP.NET Core framework logs in console unless Warning/Error -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console,file" />
    <logger name="Microsoft.*" minlevel="Warning" writeTo="console,file" />
    <logger name="System.Net.Http.*" minlevel="Warning" writeTo="console,file" />
    <!-- App logs -->
    <logger name="OpenFlux.Zen.Server.*" minlevel="Debug" writeTo="console,file" />
    <logger name="*" minlevel="Info" writeTo="console,file" />
  </rules>
</nlog>
