<?xml version="1.0" encoding="utf-8" ?><nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"><targets><target xsi:type="File" name="file" fileName="${basedir}/logs/panel.log" layout="${longdate}|${level}|${message}" /></targets><rules><logger name="*" minlevel="Info" writeTo="file" /></rules></nlog>
